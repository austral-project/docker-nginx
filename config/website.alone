# Rendered by docker-entrypoint.sh (envsubst) -> ${NGINX_RUN_DIR}/sites/website.conf  (MODE=static)
server {
  listen ${LISTEN_PORT};
  server_name _;
  server_name_in_redirect off;

  root ${WEBSITE_ROOT}/${PUBLIC_DIR};
  index index.html;

  include ${NGINX_RUN_DIR}/snippets/security-headers.conf;
  include ${NGINX_RUN_DIR}/snippets/error-pages.conf;

  # Extra directives / locations of the project: /overrides/server.d/*.conf
  include ${OVERRIDES_DIR}/server.d/*.conf;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Hidden files (.git, .env, .htaccess...), except /.well-known/
  location ~ /\.(?!well-known(?:/|$)) {
    access_log off;
    log_not_found off;
    return 404;
  }

  # Static files
  location ~* \.(?:css|js|mjs|map|webp|avif|jpe?g|png|gif|svg|ico|woff2?|ttf|otf|eot|txt|srt|swf|mp4|webm|mp3|pdf|json|xml)$ {
    try_files $uri =404;
    include ${NGINX_RUN_DIR}/snippets/static-headers.conf;
  }

  # HTML (also the SPA fallback /index.html): always revalidated, so a new deployment is seen at once
  location ~* \.html?$ {
    try_files $uri =404;
    include ${NGINX_RUN_DIR}/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  # SPA: unknown routes return index.html
  location / {
    try_files $uri $uri/ /index.html;
  }
}
